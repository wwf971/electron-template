{
  "appId": "com.wwf971.electron-utils",
  "productName": "ElectronUtils",
  "directories": {
    "output": "../build/win-single"
  },
  "compression": "store",
  "extraResources": [
    {
      "from": "../frontend/build",
      "to": "react-build",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../build/electron-utils",
      "to": "electron-utils",
      "filter": [
        "**/*"
      ]
    }
  ],
  "files": [
    {
      "from": "../backend",
      "to": ".",
      "filter": ["main.js", "preload.js", "electron-utils.js"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": null
  },
  "portable": {
    "artifactName": "ElectronUtils.exe"
  }
}
