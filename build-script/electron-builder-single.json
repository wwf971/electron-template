{
  "appId": "com.wwf971.electron-react-template",
  "productName": "Electron React Template",
  "directories": {
    "output": "../build-single"
  },
  "compression": "store",
  "extraResources": [
    {
      "from": "../frontend/build",
      "to": "react-build",
      "filter": [
        "**/*"
      ]
    }
  ],
  "files": [
    {
      "from": "../backend",
      "to": ".",
      "filter": ["main.js", "preload.js"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": null
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": null
  },
  "portable": {
    "artifactName": "HelloWorld-${version}-portable.exe"
  }
}
